    "faq_header": "الأسئلة الشائعة",
    "faqs": {
        "0": {
            "text": "ما هي أدوات؟",
            "description": "أدوات هي شركة صيانة منزلية توفر فنيين خبراء لخدمات المكيفات (تنظيف، تركيب، إصلاح) ومختلف الأجهزة المنزلية مثل الثلاجات وغسالات الصحون والغسالات وغيرها."
        },
        "1": {
            "text": "ما هي الخدمات التي تقدمها أدوات؟",
            "description": "تقدم أدوات خدمات التنظيف والتركيب والإصلاح والصيانة لمكيفات الهواء ومجموعة واسعة من الأجهزة المنزلية بما في ذلك غسالات الصحون والثلاجات والأفران والغسالات وغيرها."
        },
        "2": {
            "text": "كيف يمكنني حجز خدمة مع أدوات؟",
            "description": "يمكنك بسهولة حجز خدمة عن طريق زيارة موقعنا الإلكتروني أو تطبيق الهاتف المحمول، واختيار الخدمة المطلوبة وتحديد وقت مناسب."
        },
        "3": {
            "text": "هل فنيو أدوات معتمدون؟",
            "description": "نعم، جميع فنيينا مدربون ومعتمدون بشكل احترافي للتعامل مع مجموعة متنوعة من مشاكل الأجهزة والمكيفات."
        },
        "4": {
            "text": "هل تقدم أدوات خدمات إصلاح طارئة؟",
            "description": "نعم، نقدم خدمات إصلاح في نفس اليوم وخدمات طارئة حسب التوفر في منطقتك."
        },
        "5": {
            "text": "ما هي المدن أو المناطق التي تخدمها أدوات حاليًا؟",
            "description": "أدوات متاحة حاليًا في المدن الرئيسية. يرجى التحقق من قسم منطقة الخدمة على الموقع الإلكتروني أو التطبيق لتأكيد التوفر في موقعك."
        },
        "6": {
            "text": "هل هناك ضمان على الخدمات المقدمة من أدوات؟",
            "description": "نعم، نقدم ضمان خدمة على معظم إصلاحاتنا. يمكن العثور على التفاصيل في تأكيد الخدمة أو عن طريق الاتصال بفريق الدعم."
        },
        "7": {
            "text": "هل يمكنني جدولة صيانة دورية للأجهزة مع أدوات؟",
            "description": "بالتأكيد! نقدم خطط صيانة دورية للمكيفات والأجهزة للحفاظ على عملها بكفاءة على مدار العام."
        },
        "8": {
            "text": "كم تكلفة خدمات أدوات؟",
            "description": "تختلف الأسعار حسب نوع الخدمة وتعقيدها. سيتم تقديم عرض مفصل قبل تأكيد الخدمة."
        },
        "9": {
            "text": "كيف يمكنني الاتصال بدعم عملاء أدوات؟",
            "description": "يمكنك الوصول إلينا على مدار الساعة عبر الهاتف أو البريد الإلكتروني أو الدردشة الحية على موقعنا الإلكتروني أو تطبيق الهاتف المحمول."
        }
